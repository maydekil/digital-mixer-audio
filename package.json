{
  "name": "local-audio-mixer",
  "private": true,
  "version": "0.0.0-ui-preview",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:ui",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:desktop:ui": "node scripts/dev-desktop-ui.mjs",
    "dev:engine": "node scripts/dev-engine.mjs",
    "build:desktop:main": "node scripts/build-desktop-main.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:native:sound-pad": "node scripts/build-native-sound-pad.mjs",
    "build": "npm run build:native && npm run build:ui",
    "doctor": "node scripts/doctor.mjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "vitest run",
    "test:native": "node scripts/test-native.mjs",
    "build:ui": "tsc --noEmit && vite build && npm run build:desktop:main",
    "test:e2e": "npm run test:visual",
    "test:visual": "playwright test tests/ui/visual.visual.ts --reporter=line",
    "package:mac:unsigned": "node scripts/package-mac-unsigned.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:plan": "node scripts/check-plan.mjs",
    "verify": "npm run check:plan && npm run check:file-size && npm run check:architecture && npm run typecheck && npm run test:ui && npm run test:native && npm run build:ui"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/ui": "3.2.4",
    "electron": "44.3.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
